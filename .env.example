# Postgres — doporučeno Neon (serverless, zdarma pro malé projekty, viz README).
# Pooled connection string (přes -pooler), používá ho aplikace za běhu.
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/hlasuju?sslmode=require

# Přímé (ne pooled) connection string — používají ho jen migrace
# (drizzle-kit/db:migrate). U Neonu je to stejný host bez "-pooler".
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.eu-central-1.aws.neon.tech/hlasuju?sslmode=require

# Resend — volitelné. Bez klíče appka funguje normálně, jen se
# neodešle e-mail s odkazem na hlasování (viz README).
RESEND_API_KEY=
RESEND_FROM_EMAIL=hlasuju.cz <onboarding@resend.dev>

# Obrázky u otázek — Universal Content API (content-api.darbujan.com).
# Token projektu "hlasuju" se scopy media:upload + media:delete; jen na
# serveru (nikdy NEXT_PUBLIC_). Bez tokenu appka funguje, jen editor
# nenabídne nahrání obrázku (viz README).
CONTENT_API_TOKEN=
# Volitelné (výchozí hodnoty):
# CONTENT_API_URL=https://content-api.darbujan.com
# CONTENT_API_PROJECT=hlasuju

# Denní úklid (vercel.json → /api/cron/cleanup). Vercel ho posílá jako
# "Authorization: Bearer <CRON_SECRET>". Bez něj je endpoint zavřený.
CRON_SECRET=
